# Non-secret deployment config, read by deploy/compose.yaml.
#
# Committed on purpose: hostnames, URLs and identifiers are not secrets, and
# keeping them in git means a change to what the service advertises shows up in a
# pull request diff rather than in a web form with no history.
#
# Credentials are not here. The deploy workflow passes them through its own
# environment, where compose picks them up when it interpolates.

# The name nginx-proxy routes on. The DNS record does not exist yet; until it
# does, reach the service by adding this line to /etc/hosts:
#
#   3.69.83.252  wallet-provider.eudiw.grnet.gr
#
# LETSENCRYPT_HOST is commented out in compose.yaml for the same reason. The
# HTTP-01 challenge needs the name to resolve to the box, and failed attempts
# count against Let's Encrypt rate limits.
WALLET_PROVIDER_HOST=wallet-provider.eudiw.grnet.gr

# Signed into every wallet unit attestation as `iss` and validated by the wallet,
# so it has to be the public name. Becomes https once a certificate is issued;
# changing it afterwards invalidates attestations already held by wallets.
ISSUER_PUBLICURL=http://wallet-provider.eudiw.grnet.gr

# Used by acme-companion as the registration address. Only read when the acme
# profile is running.
LETSENCRYPT_EMAIL=noc@grnet.gr

# OAuth client id for attestation-based client authentication. Must match what
# the wallet sends; the Android app sets clientId = "eudiw-abca". Upstream
# defaults to "wallet-dev".
CLIENTID=eudiw-abca

WALLET_NAME=GRNET
WALLET_LINK=https://grnet.gr
WALLET_VERSION=v0.1
WALLET_CERTIFICATION_INFO=N/A

KEYATTESTATION_CERTIFICATION=https://ec.europa.eu

# Allocates a revocation index per attestation issued; not reversible.
# Drops the port once the status list moves behind the proxy, together with its
# own service_url, which it signs into tokens as `sub`.
TOKENSTATUSLISTSERVICE_SERVICEURL=https://demo.eudiw.grnet.gr:5603/token_status_list/take

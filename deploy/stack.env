# Non-secret deployment config, read by deploy/compose.yaml.
#
# Committed on purpose: hostnames, URLs and identifiers are not secrets, and
# keeping them in git means a change to what the service advertises shows up in a
# pull request diff rather than in a web form with no history.
#
# Credentials are not here. The deploy workflow passes them through its own
# environment, where compose picks them up when it interpolates.

# The name nginx-proxy routes on.
# The hostname the whole demo shares. Used for this service's own VIRTUAL_HOST
# and for the per-vhost nginx config this stack mounts on behalf of others, so
# it appears in both. One value, one place to change it.
EDGE_HOST=demo.eudiw.grnet.gr

WALLET_PROVIDER_HOST=${EDGE_HOST}

# The CRL's path, served over plain http by the edge's exception. Must match
# CRL_PATH in eudi-srv-web-issuing-eudiw-py, and neither is free to change: the
# IACA signs http://<host>/revocation/crl.pem into every certificate.
CRL_PATH=/revocation/

# The IACA's SHA-256 fingerprint, shown on the landing page so a partner can
# check the certificate they downloaded from /pki/. Changes only when the IACA
# is reissued; deploy.sh fails if it no longer matches what /pki/ serves.
#   openssl x509 -in pki/ca/root-ca-grnet.pem -noout -fingerprint -sha256
IACA_SHA256=D3:CB:EF:88:C3:CE:0F:A0:4A:3D:A8:8A:28:4A:38:14:9B:5A:E1:4F:D9:08:0B:8C:FA:4D:CE:51:47:CA:F7:14

# Empty to serve at the hostname root instead.
WALLET_PROVIDER_PATH=/wallet-provider/

# Signed into every wallet unit attestation as `iss` and validated by the wallet,
# so it has to be the public name. Becomes https once a certificate is issued;
# changing it afterwards invalidates attestations already held by wallets.
ISSUER_PUBLICURL=https://demo.eudiw.grnet.gr/wallet-provider

# ACME registration address.
LETSENCRYPT_EMAIL=devops-rnd@grnet.gr


# OAuth client id for attestation-based client authentication. Must match what
# the wallet sends; the Android app sets clientId = "eudiw-abca". Upstream
# defaults to "wallet-dev".
CLIENTID=eudiw-abca

WALLET_NAME=GRNET
WALLET_LINK=https://grnet.gr
WALLET_VERSION=v0.1
WALLET_CERTIFICATION_INFO=N/A

KEYATTESTATION_CERTIFICATION=https://ec.europa.eu

# Allocates a revocation index per attestation issued; not reversible.
# Posted to verbatim as a full endpoint URL, so the path stays and only the port
# goes. Portless since the status list moved behind the proxy on 443, where its
# own SERVICE_URL must match or the two disagree about what they signed.
TOKENSTATUSLISTSERVICE_SERVICEURL=https://demo.eudiw.grnet.gr/token_status_list/take
